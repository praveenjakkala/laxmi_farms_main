# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App Deployment Mode
# Options: 'universal' (default), 'admin', 'customer'
# 'customer': Blocks all /admin routes.
# 'admin': Redirects homepage to Admin Dashboard.
NEXT_PUBLIC_APP_MODE=universal
